# ---------- Core ----------
# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/demodash?schema=public"
# Long random string used to sign login sessions and phone-verification tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL (used in emails / links)
APP_URL="http://localhost:3000"

# ---------- Branding ----------
SHOP_NAME="Rai Communication"
SHOP_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_NAME="DemoDash"

# ---------- Customer phone OTP ----------
# true = customer must verify their phone with an SMS OTP before booking.
# Set to false until an SMS provider below is configured in production.
REQUIRE_PHONE_OTP="true"

# ---------- Notifications ----------
# Where new-booking alerts go (comma-separated emails / a single phone in E.164 or 10-digit Indian format)
ADMIN_NOTIFY_EMAIL="owner@example.com"
ADMIN_NOTIFY_PHONE=""
# Optional WhatsApp alert to the owner (requires SMS_PROVIDER=twilio and a WhatsApp-enabled sender)
ADMIN_NOTIFY_WHATSAPP=""

# Email via SMTP (works with Gmail app passwords, Brevo, Resend SMTP: host smtp.resend.com / user "resend" / pass <API key>).
# Leave SMTP_HOST empty to only log emails to the console + NotificationLog table.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DemoDash <no-reply@example.com>"

# SMS: console | twilio | msg91     ("console" just prints messages; in dev the OTP is also returned to the UI)
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""          # e.g. +15551234567
TWILIO_WHATSAPP_FROM=""        # e.g. whatsapp:+14155238886
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""           # DLT-approved Flow template with one variable (see MSG91_VAR_NAME)
MSG91_VAR_NAME="message"

# ---------- Image uploads ----------
# Cloudinary (recommended for production). If empty, files are stored in ./.uploads (local/dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="demodash"

# ---------- Maps (optional) ----------
# Used only for reverse geocoding ("use my location" -> address text). Falls back to OpenStreetMap Nominatim if empty.
GOOGLE_MAPS_API_KEY=""
